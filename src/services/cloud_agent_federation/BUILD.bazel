load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "cloud_agent_federation_lib",
    srcs = ["main.go"],
    importpath = "github.com/guardian-intelligence/guardian/src/services/cloud_agent_federation",
    visibility = ["//visibility:private"],
    deps = ["@com_github_coreos_go_oidc_v3//oidc:go_default_library"],
)

go_binary(
    name = "cloud_agent_federation",
    embed = [":cloud_agent_federation_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "cloud_agent_federation_test",
    srcs = ["main_test.go"],
    embed = [":cloud_agent_federation_lib"],
)

pkg_tar(
    name = "cloud_agent_federation_layer",
    files = {":cloud_agent_federation": "app/cloud-agent-federation"},
    modes = {"app/cloud-agent-federation": "0755"},
)

oci_image(
    name = "image",
    annotations = {
        "org.opencontainers.image.description": "Hosted-agent OIDC to bounded Guardian persona federation",
        "org.opencontainers.image.source": "https://github.com/guardian-intelligence/guardian",
        "org.opencontainers.image.title": "guardian-cloud-agent-federation",
    },
    base = "@distroless_cc_base_linux_amd64",
    entrypoint = ["/app/cloud-agent-federation"],
    exposed_ports = ["8080/tcp"],
    tars = [":cloud_agent_federation_layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["guardian/cloud-agent-federation:dev"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["edge"],
    repository = "ghcr.io/guardian-intelligence/cloud-agent-federation",
    visibility = ["//visibility:public"],
)
