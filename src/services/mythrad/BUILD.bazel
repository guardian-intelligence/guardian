load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

exports_files(
    [
        "behaviors/client.wasm",
        "behaviors/park.wasm",
        "behaviors/server.wasm",
        "terrain/fixture_park.bin",
    ],
    visibility = ["//src/services/mythrad/sim:__pkg__"],
)

go_library(
    name = "mythrad_lib",
    srcs = [
        "auth.go",
        "gateway.go",
        "main.go",
        "park.go",
        "park_server.go",
        "proxy.go",
        "session.go",
        "terrain.go",
    ],
    embedsrcs = [
        "behaviors/client.wasm",
        "behaviors/park.wasm",
        "behaviors/server.wasm",
        "terrain/fixture_park.bin",
    ],
    importpath = "github.com/guardian-intelligence/guardian/src/services/mythrad",
    visibility = ["//visibility:private"],
    deps = [
        "//src/services/mythrad/journal",
        "//src/services/mythrad/wire",
        "//src/services/telemetry",
        "@com_github_coreos_go_oidc_v3//oidc:go_default_library",
        "@com_github_jackc_pgx_v5//pgxpool:go_default_library",
        "@com_github_prometheus_client_golang//prometheus:go_default_library",
        "@com_github_prometheus_client_golang//prometheus/promauto:go_default_library",
        "@com_github_prometheus_client_golang//prometheus/promhttp:go_default_library",
        "@com_github_quic_go_quic_go//:go_default_library",
        "@com_github_quic_go_quic_go//http3:go_default_library",
        "@com_github_quic_go_webtransport_go//:go_default_library",
        "@com_github_tetratelabs_wazero//:go_default_library",
        "@com_github_tetratelabs_wazero//api:go_default_library",
        "@io_opentelemetry_go_otel//:go_default_library",
        "@io_opentelemetry_go_otel//attribute:go_default_library",
        "@io_opentelemetry_go_otel_trace//:go_default_library",
    ],
)

go_binary(
    name = "mythrad",
    embed = [":mythrad_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "chunkies-gateway",
    embed = [":mythrad_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "chunkies-park",
    embed = [":mythrad_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

# Fixed-point invariant, layer 2: scans the embedded wasm modules for float
# value-type declarations (layer 1 is the source token gate in ./sim).
go_test(
    name = "mythrad_test",
    srcs = [
        "authority_test.go",
        "proxy_test.go",
        "wasm_gate_test.go",
    ],
    data = [
        "//src/tools/postgres:dist",
        "//src/tools/postgres:initdb",
    ],
    embed = [":mythrad_lib"],
    env = {"PGTEST_INITDB": "$(rootpath //src/tools/postgres:initdb)"},
    deps = [
        "//src/services/mythrad/journal",
        "//src/services/postflight/controlplane/pgtest",
        "@com_github_jackc_pgx_v5//pgxpool:go_default_library",
    ],
)

# The image carries the service and its journal-protocol load driver; the
# loadgen Job selects it via command (k6 cannot speak WebTransport, and
# docs/loadtest.md conventions apply: results land in VictoriaMetrics,
# never only pod logs).
pkg_tar(
    name = "mythrad_layer",
    files = {
        ":mythrad": "app/mythrad",
        "//src/services/mythrad/loadgen": "app/loadgen",
    },
    modes = {
        "app/mythrad": "0755",
        "app/loadgen": "0755",
    },
)

oci_image(
    name = "image",
    annotations = {
        "org.opencontainers.image.description": "Wake Up Mythra game service: journaled deterministic simulation over WebTransport",
        "org.opencontainers.image.source": "https://github.com/guardian-intelligence/guardian",
        "org.opencontainers.image.title": "guardian-mythrad",
    },
    architecture = "amd64",
    os = "linux",
    entrypoint = ["/app/mythrad"],
    exposed_ports = [
        "4433/udp",
        "9090/tcp",
    ],
    tars = [":mythrad_layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["guardian/mythrad:dev"],
)

# Pushed by CI (.github/workflows/images.yml) on merges to main.
oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["edge"],
    repository = "ghcr.io/guardian-intelligence/mythrad",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "chunkies_gateway_layer",
    files = {
        ":chunkies-gateway": "app/chunkies-gateway",
        "//src/services/mythrad/loadgen": "app/loadgen",
    },
    modes = {
        "app/chunkies-gateway": "0755",
        "app/loadgen": "0755",
    },
)

oci_image(
    name = "chunkies_gateway_image",
    annotations = {
        "org.opencontainers.image.description": "Wake Up Mythra WebTransport session gateway",
        "org.opencontainers.image.source": "https://github.com/guardian-intelligence/guardian",
        "org.opencontainers.image.title": "chunkies-gateway",
    },
    architecture = "amd64",
    os = "linux",
    entrypoint = ["/app/chunkies-gateway"],
    exposed_ports = [
        "4433/udp",
        "9634/tcp",
    ],
    tars = [":chunkies_gateway_layer"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "chunkies_gateway_push",
    image = ":chunkies_gateway_image",
    remote_tags = ["edge"],
    repository = "ghcr.io/guardian-intelligence/chunkies-gateway",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "chunkies_park_layer",
    files = {
        ":chunkies-park": "app/chunkies-park",
    },
    modes = {
        "app/chunkies-park": "0755",
    },
)

oci_image(
    name = "chunkies_park_image",
    annotations = {
        "org.opencontainers.image.description": "Wake Up Mythra single-park simulation authority",
        "org.opencontainers.image.source": "https://github.com/guardian-intelligence/guardian",
        "org.opencontainers.image.title": "chunkies-park",
    },
    architecture = "amd64",
    os = "linux",
    entrypoint = ["/app/chunkies-park"],
    exposed_ports = [
        "9631/tcp",
        "9632/tcp",
        "9637/tcp",
    ],
    tars = [":chunkies_park_layer"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "chunkies_park_push",
    image = ":chunkies_park_image",
    remote_tags = ["edge"],
    repository = "ghcr.io/guardian-intelligence/chunkies-park",
    visibility = ["//visibility:public"],
)
