load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test")
load("//src/services/mythrad/sim:wasm.bzl", "wasm_module")

SIM_ROOT = ["//src/services/mythrad/sim:__pkg__"]

SESSION_SRCS = [
    "session/src/lib.rs",
    "session/src/tests.rs",
    "session/src/wire.rs",
]

filegroup(
    name = "sources",
    srcs = [
        "clock/src/lib.rs",
        "goldens/main.rs",
        "module/src/lib.rs",
        "tablegen/main.rs",
    ] + SESSION_SRCS,
    visibility = SIM_ROOT,
)

rust_library(
    name = "clock",
    srcs = ["clock/src/lib.rs"],
    crate_name = "mythra_sim_clock",
    edition = "2024",
)

rust_test(
    name = "clock_test",
    crate = ":clock",
    edition = "2024",
)

rust_library(
    name = "session",
    srcs = SESSION_SRCS,
    crate_name = "mythra_sim_session",
    crate_root = "session/src/lib.rs",
    edition = "2024",
    deps = [":clock"],
)

rust_test(
    name = "session_test",
    crate = ":session",
    edition = "2024",
)

rust_binary(
    name = "tablegen",
    srcs = ["tablegen/main.rs"],
    edition = "2024",
    deps = [":session"],
)

genrule(
    name = "telemetry_gen_ts",
    outs = ["telemetry.gen.ts"],
    cmd = "$(location :tablegen) $@",
    tools = [":tablegen"],
    visibility = SIM_ROOT,
)

rust_binary(
    name = "goldens_gen",
    srcs = ["goldens/main.rs"],
    edition = "2024",
    deps = [
        ":session",
        "//src/services/mythrad/sim/shared:park_lib",
        "//src/services/mythrad/sim/shared:terrain",
    ],
)

genrule(
    name = "goldens_json",
    outs = ["records.json"],
    cmd = "$(location :goldens_gen) $@",
    tools = [":goldens_gen"],
    visibility = SIM_ROOT,
)

rust_shared_library(
    name = "client_cdylib",
    srcs = ["module/src/lib.rs"],
    crate_name = "mythra_sim_client",
    edition = "2024",
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [
        ":clock",
        ":session",
        "//src/services/mythrad/sim/shared:core",
    ],
)

wasm_module(
    name = "client_wasm",
    lib = ":client_cdylib",
    out = "client.wasm",
    visibility = SIM_ROOT,
)
