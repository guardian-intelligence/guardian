load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("//src/services/mythrad/sim:wasm.bzl", "wasm_module")

# Server tier: executed only by mythrad's live/shadow behavior slot.

SIM_ROOT = ["//src/services/mythrad/sim:__pkg__"]

filegroup(
    name = "sources",
    srcs = ["module/src/lib.rs"],
    visibility = SIM_ROOT,
)

rust_shared_library(
    name = "server_cdylib",
    srcs = ["module/src/lib.rs"],
    crate_name = "mythra_sim_server",
    edition = "2024",
    target_compatible_with = ["@platforms//cpu:wasm32"],
)

wasm_module(
    name = "server_wasm",
    lib = ":server_cdylib",
    out = "server.wasm",
    visibility = SIM_ROOT,
)
