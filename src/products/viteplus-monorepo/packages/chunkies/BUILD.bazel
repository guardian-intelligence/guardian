load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages()

exports_files(
    ["src/telemetry.gen.ts"],
    visibility = ["//src/services/mythrad/sim:__pkg__"],
)

CHUNKIES_SRCS = glob([
    "package.json",
    "src/**/*",
    "tsconfig.json",
])

filegroup(
    name = "package_manifest",
    srcs = ["package.json"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sources",
    srcs = CHUNKIES_SRCS,
    visibility = ["//visibility:public"],
)

js_library(
    name = "pkg",
    srcs = CHUNKIES_SRCS,
    visibility = ["//visibility:public"],
)
