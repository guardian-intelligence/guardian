{
  "name": "@guardian/telemetry",
  "version": "0.1.0",
  "private": true,
  "description": "Shared browser telemetry for Guardian product surfaces: emitSpan queue, analytics beacon, route/web-vital probe, and by-construction error capture feeding the guardian_analytics events pipeline.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./probe": {
      "types": "./src/page-view.tsx",
      "default": "./src/page-view.tsx"
    },
    "./server-deploy-meta": {
      "types": "./src/server-deploy-meta.ts",
      "default": "./src/server-deploy-meta.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "vp exec tsc -p tsconfig.json",
    "test": "vp test run"
  },
  "dependencies": {
    "web-vitals": "catalog:"
  },
  "devDependencies": {
    "@tanstack/react-router": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-router": "*",
    "react": "^19.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
