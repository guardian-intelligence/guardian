load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages()

exports_files(
    ["goldens/records.json"],
    visibility = ["//src/services/mythrad/sim:__pkg__"],
)

exports_files(
    [
        "goldens/caps.txt",
        "goldens/vectors.txt",
    ],
    visibility = ["//src/services/mythrad/codec:__pkg__"],
)

CHUNKIES_TESTKIT_SRCS = glob([
    "goldens/**/*",
    "package.json",
    "src/**/*",
    "tsconfig.json",
])

filegroup(
    name = "package_manifest",
    srcs = ["package.json"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sources",
    srcs = CHUNKIES_TESTKIT_SRCS,
    visibility = ["//visibility:public"],
)

js_library(
    name = "pkg",
    srcs = CHUNKIES_TESTKIT_SRCS,
    visibility = ["//visibility:public"],
)
