load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages()

# Held byte-identical to the crate's dist/install.sh by
# //src/products/postflight-cli:installer_lockstep_test.
exports_files(["public/postflight/install.sh"])

filegroup(
    name = "package_manifest",
    srcs = ["package.json"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sources",
    srcs = glob([
        "package.json",
        "perf/**/*",
        "public/**/*",
        "rewrite-cjs-require.mjs",
        "rewrite-cjs-require.d.mts",
        "observability-plugin.mjs",
        "src/**/*",
        "tsconfig.json",
        "vite.config.ts",
    ]),
    visibility = ["//visibility:public"],
)

genrule(
    name = "tanstack_output_layer",
    srcs = [
        ":node_modules",
        ":node_modules/vite-plus",
        ":sources",
        "//src/products/viteplus-monorepo:vp_node",
        "//src/products/viteplus-monorepo:workspace_sources",
        # tsc resolves @guardian/brand's package.json "exports" straight to
        # its .tsx SOURCE (no prebuilt .d.ts), so typechecking the app
        # type-checks brand's source in place -- which needs brand's own
        # node_modules (react/react-dom/@types) reachable by directory
        # walk-up from brand's location in this sandbox, not just the app's.
        "//src/products/viteplus-monorepo/packages/brand:node_modules",
        ":node_modules/typescript",
    ],
    outs = ["company-site-output.tar"],
    cmd = """
set -euo pipefail
execroot="$$(pwd)"
node="$$execroot/$(location //src/products/viteplus-monorepo:vp_node)"
app_node_modules="$$execroot/$(BINDIR)/src/products/viteplus-monorepo/apps/guardianintelligence-web/node_modules"
vp="$$app_node_modules/vite-plus/bin/vp"
tsc="$$app_node_modules/typescript/bin/tsc"
test -x "$$vp"
test -f "$$tsc"
export PATH="$$(dirname "$$node"):$${PATH:-/usr/bin:/bin}"
export NODE_OPTIONS="--preserve-symlinks-main $${NODE_OPTIONS:-}"
export NODE_PATH="$$app_node_modules$${NODE_PATH:+:$$NODE_PATH}"
export CI=true
# The build runs in a scratch copy of the workspace with the Bazel-linked
# node_modules symlinked in at each package level. The source tree is never
# touched: its node_modules stays entirely under pnpm's control (`vp dev`
# keeps working while and after this builds), and the build still sees only
# Bazel-declared inputs.
work="$$(mktemp -d)"
trap 'rm -rf "$$work"' EXIT
for f in $(locations //src/products/viteplus-monorepo:workspace_sources); do
  rel="$${f#src/products/viteplus-monorepo/}"
  mkdir -p "$$work/$$(dirname "$$rel")"
  cp "$$f" "$$work/$$rel"
done
# Each node_modules is a real directory of per-entry symlinks, not a symlink
# to the bindir tree: vp writes its .vite task-cache next to the modules it
# resolves, and a directory symlink would route those writes into bazel-out,
# mutating this action's own declared inputs.
link_node_modules() {
  mkdir -p "$$2"
  find "$$1" -mindepth 1 -maxdepth 1 -exec ln -s {} "$$2/" \\;
}
mkdir -p "$$work/node_modules"
link_node_modules "$$app_node_modules" "$$work/apps/guardianintelligence-web/node_modules"
link_node_modules "$$execroot/$(BINDIR)/src/products/viteplus-monorepo/packages/brand/node_modules" "$$work/packages/brand/node_modules"
cd "$$work/apps/guardianintelligence-web"
# Mirrors package.json's own "build" script (single source of truth:
# typecheck + test + build, in that order) -- a developer running
# `pnpm run build` locally gets the identical gate CI enforces here, and a
# real type error or test regression fails the image build itself rather
# than shipping silently through Vite's transpile-only bundler. tsc is
# invoked via its exact Bazel-resolved path, NOT `vp exec tsc` (which
# package.json's own script uses) -- `vp exec` spawns external binaries via
# PATH lookup, and this scratch tree's node_modules has no .bin/ symlink
# farm (unlike a real `pnpm install`, which is what makes `vp exec` safe to
# use from package.json); a real run on a GitHub Actions runner proved this
# the hard way, resolving a stray broken global `tsc` shim on the runner
# image instead of the correct local one.
"$$node" "$$tsc" -p tsconfig.json
"$$node" "$$vp" test run
"$$node" "$$vp" build
test -s .output/server/index.mjs
# Nitro's output carries the only nondeterminism in the image: nitro.json
# stamps the build wall-clock, the server bundle embeds static-asset "mtime"
# metadata, and the public-assets manifest's key order follows readdir order.
# Normalize timestamps to the epoch (matching the tar's --mtime) and sort the
# manifest keys so the same sources always produce the same digest — the
# company-site-image workflow enforces pin == built digest on that basis.
"$$node" -e '
const fs = require("fs");
const p = ".output/nitro.json";
const s = fs.readFileSync(p, "utf8").replace(
  /"date": "[^"]*"/,
  "\\\"date\\\": \\\"1970-01-01T00:00:00.000Z\\\"",
);
fs.writeFileSync(p, s);
'
find .output/server -name '*.mjs' -exec "$$node" -e '
const fs = require("fs");
for (const p of process.argv.slice(1)) {
  const s = fs.readFileSync(p, "utf8").replace(
    /"mtime": "[^"]*"/g,
    "\\\"mtime\\\": \\\"1970-01-01T00:00:00.000Z\\\"",
  );
  fs.writeFileSync(p, s);
}
' {} +
# Machine-specific absolute paths in chunk contents (and therefore in the
# content-hashed chunk names) are prevented at the source: vite.config.ts
# sets rolldown's experimental.attachDebugInfo to "none" and relativizes the
# TanStack route-manifest filePaths. Guard that both stay effective — paths
# baked in at hash time cannot be scrubbed here.
if grep -rlE 'execroot/_main|filePath"?: ?"/' .output/server >/dev/null 2>&1; then
  echo "machine-specific absolute paths leaked into the server bundle" >&2
  exit 1
fi
"$$node" -e '
const fs = require("fs");
const p = ".output/server/index.mjs";
let s = fs.readFileSync(p, "utf8");
const m = s.match(/var public_assets_data_default = (\\{[\\s\\S]*?\\n\\});/);
if (!m) throw new Error("public assets manifest not found in " + p);
const obj = JSON.parse(m[1]);
const sorted = Object.fromEntries(Object.keys(obj).sort().map((k) => [k, obj[k]]));
s = s.replace(m[1], JSON.stringify(sorted, null, "\t"));
// Nitro derives its lazy-handler variable suffixes from machine-specific
// paths (_lazy_<suffix>). index.mjs is not content-hash-named, so renaming
// them by order of first appearance is safe and machine-invariant.
const ids = [...new Set(s.match(/_lazy_[A-Za-z0-9]+/g) || [])];
ids.forEach((id, i) => { s = s.split(id).join("_lazy_h" + i); });
fs.writeFileSync(p, s);
'
tar_bin=tar
if [[ -x /opt/homebrew/bin/gtar ]]; then
  tar_bin=/opt/homebrew/bin/gtar
elif command -v gtar >/dev/null 2>&1; then
  tar_bin=gtar
fi
"$$tar_bin" --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner \
  --mode=u=rwX,go=rX \
  --transform 's#^\\./#app/#' \
  -cf "$$execroot/$@" -C .output .
""",
    tags = [
        "no-remote",
        "no-sandbox",
    ],
)

pkg_tar(
    name = "node_layer",
    files = {
        "//src/products/viteplus-monorepo:vp_node": "usr/bin/node",
        "@cacert_pem//file": "etc/ssl/certs/ca-certificates.crt",
    },
    modes = {
        "usr/bin/node": "0755",
        "etc/ssl/certs/ca-certificates.crt": "0644",
    },
)

oci_image(
    name = "image",
    annotations = {
        "org.opencontainers.image.description": "Guardian Intelligence TanStack Start company website",
        "org.opencontainers.image.source": "https://github.com/guardian-intelligence/guardian",
        "org.opencontainers.image.title": "guardian-company-site",
    },
    base = "@distroless_cc_base_linux_amd64",
    entrypoint = [
        "/usr/bin/node",
        "/app/server/index.mjs",
    ],
    env = {
        "HOST": "0.0.0.0",
        "NODE_ENV": "production",
        "PORT": "8080",
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
    },
    exposed_ports = ["8080/tcp"],
    tars = [
        ":node_layer",
        ":tanstack_output_layer",
    ],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["guardian/company-site:dev"],
)
