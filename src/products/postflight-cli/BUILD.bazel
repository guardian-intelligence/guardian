load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy", "rust_test", "rustfmt_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

rust_binary(
    name = "postflight",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    rustc_env = {
        # Binaries carry only the crate version: commit provenance lives in the
        # OCI annotations and Fulcio certificate so identical sources rebuild
        # byte-identically and the edge lane can dedup by content. main names
        # the next stable with a `-pre` suffix; a bare version exists only on
        # the one commit a stable is cut from.
        "CARGO_PKG_VERSION": "0.3.0-pre",
    },
    visibility = ["//visibility:public"],
    deps = [
        "@postflight_cli_crates//:base64",
        "@postflight_cli_crates//:clap",
        "@postflight_cli_crates//:serde",
        "@postflight_cli_crates//:serde_json",
        "@postflight_cli_crates//:thiserror",
        "@postflight_cli_crates//:ureq",
    ],
)

# The infrastructure conformance tests read the compiled-in issuer out of the
# crate source to hold the deep-test runner's forged credentials to it.
filegroup(
    name = "sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "installer",
    srcs = ["dist/install.sh"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "postflight_test",
    crate = ":postflight",
    edition = "2024",
)

# Built as part of //... so clippy findings gate CI like any other target.
rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":postflight",
        ":postflight_test",
    ],
)

# Same shape for formatting: drift fails `bazelisk test //...`; the fix is
# `aspect tidy`.
rustfmt_test(
    name = "rustfmt_test",
    targets = [
        ":postflight",
        ":postflight_test",
    ],
)

sh_test(
    name = "toolchain_lockstep_test",
    srcs = ["toolchain_lockstep_test.sh"],
    args = [
        "$(location rust.MODULE.bazel)",
        "$(location rust-toolchain.toml)",
    ],
    data = [
        "rust.MODULE.bazel",
        "rust-toolchain.toml",
    ],
)

sh_test(
    name = "packaging_lockstep_test",
    srcs = ["packaging_lockstep_test.sh"],
    args = [
        "$(location Cargo.toml)",
        "$(location BUILD.bazel)",
        "$(location Makefile)",
    ],
    data = [
        "BUILD.bazel",
        "Cargo.toml",
        "Makefile",
    ],
)

sh_test(
    name = "installer_test",
    size = "small",
    srcs = ["installer_test.sh"],
    args = [
        "$(rootpath dist/install.sh)",
        "$(rootpath testdata/releases-mixed/page-1.json)",
        "$(rootpath testdata/releases-nightly-only/page-1.json)",
        "$(rootpath testdata/releases-stable-only/page-1.json)",
    ],
    data = [
        "dist/install.sh",
        "testdata/releases-mixed/page-1.json",
        "testdata/releases-nightly-only/page-1.json",
        "testdata/releases-stable-only/page-1.json",
    ],
)

sh_test(
    name = "installer_lockstep_test",
    size = "small",
    srcs = ["installer_lockstep_test.sh"],
    args = [
        "$(location dist/install.sh)",
        "$(location //src/products/viteplus-monorepo/apps/guardianintelligence-web:public/postflight/install.sh)",
    ],
    data = [
        "dist/install.sh",
        "//src/products/viteplus-monorepo/apps/guardianintelligence-web:public/postflight/install.sh",
    ],
)

alias(
    name = "format",
    actual = "@rules_rust//tools/rustfmt",
    tags = ["guardian-format"],
)
