{
  "name": "@guardian/wum-client",
  "version": "0.1.0",
  "private": true,
  "description": "Wake Up Mythra's game layer over the @guardian/chunkies replica host: intent verbs, HUD/view/terrain decodes, the glide presenter, and the isometric renderer. Everything that makes the replica a dog park lives here, not in the host.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "vp exec tsc -p tsconfig.json",
    "test": "vp test run"
  },
  "dependencies": {
    "@guardian/chunkies": "workspace:*"
  },
  "devDependencies": {
    "@guardian/chunkies-testkit": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
