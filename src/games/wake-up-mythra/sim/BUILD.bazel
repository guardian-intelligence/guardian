load("@aspect_bazel_lib//lib:diff_test.bzl", "diff_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test", "rustfmt_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//src/chunkies/sim:wasm.bzl", "wasm_module")

# The Wake Up Mythra world simulation. Everything here is the game's: the
# rules, the terrain format, the pathfinder, and the fixed-point core they
# share. Game logic belongs in these crates and nowhere else -- if Go or
# TypeScript can read a rule, the rule is in the wrong place.
#
# The dependency direction is one-way: this game depends on chunkies (the
# ABI it exports through), and chunkies depends on nothing here.

# The framework's fixed-point gate needs this game's sources; the game's
# own client stack (client/) links the park for its goldens generator.
CHUNKIES_SIM = ["//src/chunkies/sim:__pkg__"]

GAME_CLIENT = ["//src/games/wake-up-mythra/sim/client:__pkg__"]

filegroup(
    name = "sources",
    srcs = [
        "core/src/lib.rs",
        "nav/src/lib.rs",
        "park/src/lib.rs",
        "terrain/fixture/main.rs",
        "terrain/src/lib.rs",
    ],
    visibility = CHUNKIES_SIM,
)

rust_library(
    name = "core",
    srcs = ["core/src/lib.rs"],
    crate_name = "mythra_sim_core",
    edition = "2024",
)

rust_test(
    name = "core_test",
    crate = ":core",
    edition = "2024",
)

rust_library(
    name = "terrain",
    srcs = ["terrain/src/lib.rs"],
    crate_name = "mythra_sim_terrain",
    edition = "2024",
    visibility = GAME_CLIENT,
    deps = [":core"],
)

rust_test(
    name = "terrain_test",
    crate = ":terrain",
    edition = "2024",
)

rust_library(
    name = "nav",
    srcs = ["nav/src/lib.rs"],
    crate_name = "mythra_sim_nav",
    edition = "2024",
    deps = [
        ":core",
        ":terrain",
    ],
)

rust_test(
    name = "nav_test",
    crate = ":nav",
    edition = "2024",
)

rust_binary(
    name = "fixture_gen",
    srcs = ["terrain/fixture/main.rs"],
    edition = "2024",
    deps = [":terrain"],
)

genrule(
    name = "fixture_park",
    outs = ["fixture_park.bin"],
    cmd = "$(location :fixture_gen) $@",
    tools = [":fixture_gen"],
    visibility = CHUNKIES_SIM,
)

rust_library(
    name = "park_lib",
    srcs = ["park/src/lib.rs"],
    crate_name = "mythra_sim_park",
    edition = "2024",
    visibility = GAME_CLIENT,
    deps = [
        ":core",
        ":nav",
        ":terrain",
        "//src/chunkies/sim/shared:abi",
    ],
)

rust_test(
    name = "park_test",
    crate = ":park_lib",
    edition = "2024",
)

rust_shared_library(
    name = "park_cdylib",
    srcs = ["park/src/lib.rs"],
    crate_name = "mythra_sim_park",
    edition = "2024",
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [
        ":core",
        ":nav",
        ":terrain",
        "//src/chunkies/sim/shared:abi",
    ],
)

wasm_module(
    name = "park_wasm",
    lib = ":park_cdylib",
    out = "park.wasm",
    visibility = CHUNKIES_SIM,
)

# Copies freshly built modules, the fixture terrain, the generated
# telemetry table, and the record-layout goldens over the committed
# artifacts (the prod ConfigMap copy plus the framework-facing tables the
# game's generators still feed). The diff tests below fail the build when
# source and committed bytes drift.
sh_binary(
    name = "refresh",
    srcs = ["refresh.sh"],
    data = [
        ":fixture_park",
        ":park_wasm",
        "//src/games/wake-up-mythra/sim/client:client_wasm",
        "//src/games/wake-up-mythra/sim/client:goldens_json",
        "//src/games/wake-up-mythra/sim/client:telemetry_gen_ts",
    ],
)

diff_test(
    name = "client_artifact_current_test",
    file1 = "//src/games/wake-up-mythra/sim/client:client_wasm",
    file2 = "//src/games/wake-up-mythra/deploy/prod:behavior/client.wasm",
)

diff_test(
    name = "sim_artifact_current_test",
    file1 = ":park_wasm",
    file2 = "//src/games/wake-up-mythra/deploy/prod:behavior/sim.wasm",
)

diff_test(
    name = "fixture_artifact_current_test",
    file1 = ":fixture_park",
    file2 = "//src/games/wake-up-mythra/services/wum:fixture_park.bin",
)

diff_test(
    name = "telemetry_table_current_test",
    file1 = "//src/games/wake-up-mythra/sim/client:telemetry_gen_ts",
    file2 = "//src/chunkies/host/ts:src/telemetry.gen.ts",
)

diff_test(
    name = "goldens_current_test",
    file1 = "//src/games/wake-up-mythra/sim/client:goldens_json",
    file2 = "//src/chunkies/testkit/ts:goldens/records.json",
)

# Formatting drift fails `bazelisk test //...`; the fix is `aspect tidy`.
rustfmt_test(
    name = "rustfmt_test",
    targets = [
        ":core",
        ":core_test",
        ":fixture_gen",
        ":nav",
        ":nav_test",
        ":park_lib",
        ":park_test",
        ":terrain",
        ":terrain_test",
    ],
)
