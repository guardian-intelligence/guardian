filegroup(
    name = "manifests",
    srcs = glob(
        [
            "*.yaml",
            "topology/**/*.yaml",
            "topology/*.conf",
        ],
        # JSON6902 patch lists are kustomize inputs, not manifests; the
        # admission walkers must not try to decode them as objects.
        exclude = ["**/*.patch.yaml"],
    ),
    visibility = ["//visibility:public"],
)

# Kept in lockstep with the service's committed sim modules by the diff
# tests in //src/chunkies/sim.
exports_files(
    [
        "behavior/client.wasm",
        "behavior/park.wasm",
    ],
    visibility = ["//src/chunkies/sim:__pkg__"],
)
