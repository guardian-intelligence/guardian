load("@aspect_bazel_lib//lib:diff_test.bzl", "diff_test")

filegroup(
    name = "manifests",
    srcs = glob(
        [
            "*.yaml",
            "topology/**/*.yaml",
            "topology/*.conf",
        ],
        # JSON6902 patch lists are kustomize inputs, not manifests; the
        # admission walkers must not try to decode them as objects.
        exclude = ["**/*.patch.yaml"],
    ),
    visibility = ["//visibility:public"],
)

# Kept in lockstep with the service's committed sim modules by the diff
# tests in //src/chunkies/sim.
exports_files(
    [
        "behavior/client.wasm",
        "behavior/sim.wasm",
    ],
    visibility = ["//src/chunkies/sim:__pkg__"],
)

# The mounted game content the chunkies host boot-reads must be the same
# bytes the game's own package holds.
diff_test(
    name = "game_manifest_lockstep_test",
    file1 = "behavior/game.conf",
    file2 = "//src/games/wake-up-mythra/services/wum:game.conf",
)

diff_test(
    name = "genesis_lockstep_test",
    file1 = "behavior/genesis.bin",
    file2 = "//src/games/wake-up-mythra/services/wum:fixture_park.bin",
)
