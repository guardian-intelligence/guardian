load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "chunkie",
    srcs = [
        "config.go",
        "metrics.go",
        "chunkie.go",
        "server.go",
        "session.go",
        "terrain.go",
        "vocab.go",
    ],
    importpath = "github.com/guardian-intelligence/guardian/src/chunkies/chunkie",
    visibility = ["//src/chunkies:__subpackages__"],
    deps = [
        "//src/chunkies/journal",
        "//src/chunkies/mount",
        "//src/chunkies/trunk",
        "//src/chunkies/codec",
        "//src/shared/go/telemetry",
        "@com_github_jackc_pgx_v5//pgxpool:go_default_library",
        "@com_github_prometheus_client_golang//prometheus:go_default_library",
        "@com_github_prometheus_client_golang//prometheus/promauto:go_default_library",
        "@com_github_prometheus_client_golang//prometheus/promhttp:go_default_library",
        "@com_github_tetratelabs_wazero//:go_default_library",
        "@com_github_tetratelabs_wazero//api:go_default_library",
        "@io_opentelemetry_go_otel//:go_default_library",
        "@io_opentelemetry_go_otel//attribute:go_default_library",
        "@io_opentelemetry_go_otel_trace//:go_default_library",
    ],
)

go_test(
    name = "chunkie_test",
    srcs = [
        "authority_test.go",
        "server_test.go",
    ],
    data = [
        "//src/chunkies/sim/shared:toy_wasm",
        "//src/tools/postgres:dist",
        "//src/tools/postgres:initdb",
    ],
    embed = [":chunkie"],
    env = {"PGTEST_INITDB": "$(rootpath //src/tools/postgres:initdb)"},
    deps = [
        "//src/chunkies/journal",
        "//src/chunkies/mount",
        "//src/chunkies/trunk",
        "//src/chunkies/codec",
        "//src/postflight/controlplane/pgtest",
        "@com_github_jackc_pgx_v5//pgxpool:go_default_library",
    ],
)
