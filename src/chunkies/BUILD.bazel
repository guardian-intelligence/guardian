load("@rules_go//go:def.bzl", "go_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Two processes, two binaries, two images. Nothing is argv-dispatched from
# a shared binary: a change to runtime code must not change the gateway
# image's bytes (or vice versa), so image automation rolls exactly the
# component that updated. Codec changes roll both — correctly.

go_binary(
    name = "chunkies-gateway",
    embed = ["//src/chunkies/cmd/chunkies-gateway:chunkies-gateway_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "chunkies-chunkie",
    embed = ["//src/chunkies/cmd/chunkies-chunkie:chunkies-chunkie_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "chunkies_gateway_layer",
    files = {
        ":chunkies-gateway": "app/chunkies-gateway",
    },
    modes = {
        "app/chunkies-gateway": "0755",
    },
)

oci_image(
    name = "chunkies_gateway_image",
    annotations = {
        "org.opencontainers.image.description": "Chunkies WebTransport session gateway",
        "org.opencontainers.image.source": "https://github.com/guardian-intelligence/guardian",
        "org.opencontainers.image.title": "chunkies-gateway",
    },
    architecture = "amd64",
    os = "linux",
    entrypoint = ["/app/chunkies-gateway"],
    exposed_ports = [
        "4433/udp",
        "9634/tcp",
    ],
    tars = [":chunkies_gateway_layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "chunkies_gateway_load",
    image = ":chunkies_gateway_image",
    repo_tags = ["guardian/chunkies-gateway:dev"],
)

oci_push(
    name = "chunkies_gateway_push",
    image = ":chunkies_gateway_image",
    remote_tags = ["edge"],
    repository = "ghcr.io/guardian-intelligence/chunkies-gateway",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "chunkies_chunkie_layer",
    files = {
        ":chunkies-chunkie": "app/chunkies-chunkie",
    },
    modes = {
        "app/chunkies-chunkie": "0755",
    },
)

oci_image(
    name = "chunkies_chunkie_image",
    annotations = {
        "org.opencontainers.image.description": "Chunkies server runtime: this pod's chunk authorities",
        "org.opencontainers.image.source": "https://github.com/guardian-intelligence/guardian",
        "org.opencontainers.image.title": "chunkies-chunkie",
    },
    architecture = "amd64",
    os = "linux",
    entrypoint = ["/app/chunkies-chunkie"],
    exposed_ports = [
        "9631/tcp",
        "9632/tcp",
        "9637/tcp",
    ],
    tars = [":chunkies_chunkie_layer"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "chunkies_chunkie_push",
    image = ":chunkies_chunkie_image",
    remote_tags = ["edge"],
    repository = "ghcr.io/guardian-intelligence/chunkies-chunkie",
    visibility = ["//visibility:public"],
)
