load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "chunkies_lib",
    srcs = ["main.go"],
    importpath = "github.com/guardian-intelligence/guardian/src/chunkies",
    visibility = ["//visibility:private"],
    deps = [
        "//src/chunkies/gateway",
        "//src/chunkies/park",
    ],
)

go_binary(
    name = "chunkies-gateway",
    embed = [":chunkies_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "chunkies-park",
    embed = [":chunkies_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "chunkies_gateway_layer",
    files = {
        ":chunkies-gateway": "app/chunkies-gateway",
    },
    modes = {
        "app/chunkies-gateway": "0755",
    },
)

oci_image(
    name = "chunkies_gateway_image",
    annotations = {
        "org.opencontainers.image.description": "Wake Up Mythra WebTransport session gateway",
        "org.opencontainers.image.source": "https://github.com/guardian-intelligence/guardian",
        "org.opencontainers.image.title": "chunkies-gateway",
    },
    architecture = "amd64",
    os = "linux",
    entrypoint = ["/app/chunkies-gateway"],
    exposed_ports = [
        "4433/udp",
        "9634/tcp",
    ],
    tars = [":chunkies_gateway_layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "chunkies_gateway_load",
    image = ":chunkies_gateway_image",
    repo_tags = ["guardian/chunkies-gateway:dev"],
)

oci_push(
    name = "chunkies_gateway_push",
    image = ":chunkies_gateway_image",
    remote_tags = ["edge"],
    repository = "ghcr.io/guardian-intelligence/chunkies-gateway",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "chunkies_park_layer",
    files = {
        ":chunkies-park": "app/chunkies-park",
    },
    modes = {
        "app/chunkies-park": "0755",
    },
)

oci_image(
    name = "chunkies_park_image",
    annotations = {
        "org.opencontainers.image.description": "Wake Up Mythra single-park simulation authority",
        "org.opencontainers.image.source": "https://github.com/guardian-intelligence/guardian",
        "org.opencontainers.image.title": "chunkies-park",
    },
    architecture = "amd64",
    os = "linux",
    entrypoint = ["/app/chunkies-park"],
    exposed_ports = [
        "9631/tcp",
        "9632/tcp",
        "9637/tcp",
    ],
    tars = [":chunkies_park_layer"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "chunkies_park_push",
    image = ":chunkies_park_image",
    remote_tags = ["edge"],
    repository = "ghcr.io/guardian-intelligence/chunkies-park",
    visibility = ["//visibility:public"],
)
