load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rustfmt_test")

# The framework's client-side Rust surface is exactly the wire protocol.
# The replica engine a game links (session core, clock, presentation) is
# game code — WUM's lives in //src/games/wake-up-mythra/sim/client — and
# comes back here only if a second game proves a shared primitive.

# Held to the same fixed-point gate as every sim source.
filegroup(
    name = "sources",
    srcs = [
        "codec/src/lib.rs",
        "codec/src/tests.rs",
    ],
    visibility = ["//src/chunkies/sim:__pkg__"],
)

# The wire codec, v5. Game-blind by construction: it must never grow a
# dependency on any sim crate. Conformance is against the shared spec in
# //src/chunkies/codec:spec, compiled in so the three language
# implementations cannot drift apart.
rust_library(
    name = "codec",
    srcs = [
        "codec/src/lib.rs",
        "codec/src/tests.rs",
    ],
    crate_name = "chunkies_codec",
    crate_root = "codec/src/lib.rs",
    edition = "2024",
    visibility = ["//src/games:__subpackages__"],
)

rust_test(
    name = "codec_test",
    compile_data = ["//src/chunkies/codec:spec"],
    crate = ":codec",
    edition = "2024",
)

# Formatting drift fails `bazelisk test //...`; the fix is `aspect tidy`.
rustfmt_test(
    name = "rustfmt_test",
    targets = [
        ":codec",
        ":codec_test",
    ],
)
