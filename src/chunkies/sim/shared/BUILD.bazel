load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test", "rustfmt_test")
load("//src/chunkies/sim:wasm.bzl", "wasm_module")

# Shared tier: everything here runs byte-identically under wazero on the
# server and in every client — anything that can influence sim_hash.
#
# Game-blind by construction. Nothing in this package may depend on a crate
# under //src/games; the dependency runs the other way, and every game
# reaches the host through :abi.

TIER_PKGS = [
    "//src/chunkies/sim/client:__pkg__",
    "//src/games:__subpackages__",
]

SIM_ROOT = ["//src/chunkies/sim:__pkg__"]

filegroup(
    name = "sources",
    srcs = [
        "abi/src/lib.rs",
        "toy/src/lib.rs",
    ],
    visibility = SIM_ROOT,
)

# The framework ABI: the Simulation trait and the export_simulation!
# macro. Game-blind by construction — it must never grow a dependency on
# any sim crate, and every game's module crate depends on it.
rust_library(
    name = "abi",
    srcs = ["abi/src/lib.rs"],
    crate_name = "chunkies_abi",
    edition = "2024",
    visibility = TIER_PKGS,
)

# The toy reference game: the smallest simulation exercising the whole
# ABI, and the macro's own test vehicle. Built, never committed or
# deployed — gametest consumes the artifact fresh from this rule.
rust_library(
    name = "toy_lib",
    srcs = ["toy/src/lib.rs"],
    crate_name = "chunkies_toy",
    edition = "2024",
    deps = [":abi"],
)

rust_test(
    name = "toy_test",
    crate = ":toy_lib",
    edition = "2024",
)

rust_shared_library(
    name = "toy_cdylib",
    srcs = ["toy/src/lib.rs"],
    crate_name = "chunkies_toy",
    edition = "2024",
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [":abi"],
)

wasm_module(
    name = "toy_wasm",
    lib = ":toy_cdylib",
    out = "toy.wasm",
    visibility = [
        "//src/chunkies/gametest:__pkg__",
        "//src/chunkies/park:__pkg__",
    ],
)

# Formatting drift fails `bazelisk test //...`; the fix is `aspect tidy`.
rustfmt_test(
    name = "rustfmt_test",
    targets = [
        ":abi",
        ":toy_lib",
        ":toy_test",
    ],
)
