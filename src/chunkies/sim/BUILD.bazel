load("@aspect_bazel_lib//lib:diff_test.bzl", "diff_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Every game's sim sources, held to the same fixed-point invariant as the
# framework's. A game cannot opt out by forgetting to declare a gate: the gate
# lives here, and adding a game means adding a line to this list.
GAME_SIM_SOURCES = [
    "//src/games/wake-up-mythra/sim:sources",
]

# The world-sim stack, grouped by execution tier (see README.md): shared/
# runs byte-identically under wazero on the server and in every client,
# client/ and server/ are single-sided. Built artifacts are committed
# (embed default + ConfigMap delivery both need bytes in git); `bazel run
# :refresh` regenerates them and the diff tests below fail the build when
# source and committed bytes drift. The fixture terrain blob rides the
# same discipline: its bytes name every park's world, so they only change
# through an explicit refresh.

platform(
    name = "wasm32",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:public"],
)

# Copies freshly built modules, the fixture terrain, the generated
# telemetry tables, and the record-layout goldens over the committed
# artifacts (service embed copy + the prod ConfigMap copy + the TS
# package copies).
sh_binary(
    name = "refresh",
    srcs = ["refresh.sh"],
    data = [
        "//src/chunkies/sim/client:client_wasm",
        "//src/chunkies/sim/client:goldens_json",
        "//src/chunkies/sim/client:telemetry_gen_ts",
        "//src/games/wake-up-mythra/sim:fixture_park",
        "//src/games/wake-up-mythra/sim:park_wasm",
    ],
)

# Fixed-point invariant, layer 1: the float type tokens are banned from sim
# sources. Layer 2 (wasm binary scan) lives in //src/chunkies.
sh_test(
    name = "no_float_test",
    srcs = ["no_float_test.sh"],
    args = [
        "$(locations //src/chunkies/sim/shared:sources)",
        "$(locations //src/chunkies/sim/client:sources)",
    ] + ["$(locations %s)" % s for s in GAME_SIM_SOURCES],
    data = [
        "//src/chunkies/sim/client:sources",
        "//src/chunkies/sim/shared:sources",
    ] + GAME_SIM_SOURCES,
)

diff_test(
    name = "client_artifact_current_test",
    file1 = "//src/chunkies/sim/client:client_wasm",
    file2 = "//src/chunkies/mount:behaviors/client.wasm",
)

diff_test(
    name = "park_artifact_current_test",
    file1 = "//src/games/wake-up-mythra/sim:park_wasm",
    file2 = "//src/chunkies/mount:behaviors/park.wasm",
)

diff_test(
    name = "fixture_artifact_current_test",
    file1 = "//src/games/wake-up-mythra/sim:fixture_park",
    file2 = "//src/games/wake-up-mythra/services/wum:fixture_park.bin",
)

diff_test(
    name = "telemetry_table_current_test",
    file1 = "//src/chunkies/sim/client:telemetry_gen_ts",
    file2 = "//src/chunkies/host/ts:src/telemetry.gen.ts",
)

diff_test(
    name = "goldens_current_test",
    file1 = "//src/chunkies/sim/client:goldens_json",
    file2 = "//src/chunkies/testkit/ts:goldens/records.json",
)

diff_test(
    name = "client_configmap_lockstep_test",
    file1 = "//src/chunkies/mount:behaviors/client.wasm",
    file2 = "//src/infrastructure/deployments/mythra/prod:behavior/client.wasm",
)

diff_test(
    name = "park_configmap_lockstep_test",
    file1 = "//src/chunkies/mount:behaviors/park.wasm",
    file2 = "//src/infrastructure/deployments/mythra/prod:behavior/park.wasm",
)
