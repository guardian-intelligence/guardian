/bazel-*
**/.terraform/
*.tfstate
*.tfstate.*
# operator credential env files are never committed - creds come from the
# operator's secret store (sops/password manager), exported into the environment.
*.env
# the golden-image pins file is versions and checksums, never credentials.
!/src/postflight/image/pins.env
/src/aisucks/aisucks
/presenced
/.guardian/

# Local operator state that may remain after moving the ASH bootstrap tree.
/src/infrastructure/clusters/**/bootstrap/talm/secrets.yaml
/src/infrastructure/clusters/**/bootstrap/talm/secrets.encrypted.yaml
/src/infrastructure/clusters/**/bootstrap/talm/talosconfig
/src/infrastructure/clusters/**/bootstrap/talm/talosconfig.encrypted
/src/infrastructure/clusters/**/bootstrap/talm/talm.key
/src/infrastructure/clusters/**/bootstrap/talm/kubeconfig

# Archived pre-Cozystack tree. Keep source, not local dependency/build output.
/src-old/**/node_modules/
/src-old/**/dist/
/src-old/**/.vite/
/src-old/**/.turbo/
/src-old/**/.next/
/src-old/**/.output/

# Active web workspace dependency/build output is produced by Bazel/rules_js.
# The pnpm workspace root is the repo root, so its install tree lands here.
/node_modules/
/.pnpm-store/
/src/chunkies/host/ts/node_modules/
/src/chunkies/host/ts/.output/
/src/chunkies/host/ts/.vite/
/src/chunkies/host/ts/.tanstack/
/src/chunkies/testkit/ts/node_modules/
/src/chunkies/testkit/ts/.output/
/src/chunkies/testkit/ts/.vite/
/src/chunkies/testkit/ts/.tanstack/
/src/chunkies/transport/ts/node_modules/
/src/chunkies/transport/ts/.output/
/src/chunkies/transport/ts/.vite/
/src/chunkies/transport/ts/.tanstack/
/src/company/web/node_modules/
/src/company/web/.output/
/src/company/web/.vite/
/src/company/web/.tanstack/
/src/games/wake-up-mythra/client/node_modules/
/src/games/wake-up-mythra/client/.output/
/src/games/wake-up-mythra/client/.vite/
/src/games/wake-up-mythra/client/.tanstack/
/src/games/wake-up-mythra/web/node_modules/
/src/games/wake-up-mythra/web/.output/
/src/games/wake-up-mythra/web/.vite/
/src/games/wake-up-mythra/web/.tanstack/
/src/postflight/checkout/node_modules/
/src/postflight/checkout/.output/
/src/postflight/checkout/.vite/
/src/postflight/checkout/.tanstack/
/src/privatecut/web/node_modules/
/src/privatecut/web/.output/
/src/privatecut/web/.vite/
/src/privatecut/web/.tanstack/
/src/shared/ts/brand/node_modules/
/src/shared/ts/brand/.output/
/src/shared/ts/brand/.vite/
/src/shared/ts/brand/.tanstack/
/src/shared/ts/canary-journeys/node_modules/
/src/shared/ts/canary-journeys/.output/
/src/shared/ts/canary-journeys/.vite/
/src/shared/ts/canary-journeys/.tanstack/
/src/shared/ts/telemetry/node_modules/
/src/shared/ts/telemetry/.output/
