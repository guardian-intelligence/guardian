/dist/

# Cargo output from the CLI crate's make path; Bazel builds elsewhere.
/src/postflight/cli/target/

*.pem
__pycache__/

# uv-managed dev venv for the guardian-bench eval loop; Bazel tests use the
# repo Python toolchain instead.
/src/guardian-bench/.venv/
/src/guardian-bench/outputs/
